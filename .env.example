# ============================================================
# personal_worker — пример переменных окружения
# Скопируйте в .env и заполните реальными значениями
# ============================================================

# --- Оркестратор ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
WORK_DIR=/mnt/ssd/personal_worker/workspaces
STATE_DB=/mnt/ssd/personal_worker/state/orchestrator.sqlite

# --- GitHub (задачи и PR) ---
# Личный токен (PAT) с правами repo, issues, pull_requests
GITHUB_TOKEN=TODO_GITHUB_PAT
# Репозиторий, в котором создаются issues/PR (owner/name)
GITHUB_REPO=TODO_OWNER/REPO
# Вебхук-секрет для GitHub Issue webhooks (если будет использоваться)
GITHUB_WEBHOOK_SECRET=TODO_WEBHOOK_SECRET

# --- Telegram ---
TELEGRAM_BOT_TOKEN=TODO_BOT_TOKEN
# ID чата/пользователя, которому бот присылает уточнения и уведомления
TELEGRAM_ADMIN_CHAT_ID=TODO_CHAT_ID
# Разрешённые chat_id (через запятую), которым разрешено давать команды
TELEGRAM_ALLOWED_CHAT_IDS=TODO_ALLOWED_IDS

# --- OpenHands ---
# Адрес OpenHands runtime (Docker или отдельный сервис)
OPENHANDS_BASE_URL=http://localhost:3000
OPENHANDS_API_KEY=TODO_OPENHANDS_API_KEY
# LLM-провайдер и модель для OpenHands (openai / anthropic / ...)
OPENHANDS_LLM_MODEL=TODO_MODEL
OPENHANDS_LLM_API_KEY=TODO_LLM_API_KEY

# --- iMac (сборка iOS) ---
IMAC_HOST=TODO_IMAC_IP_ILИ_ИМЯ        # например 192.168.88.42
IMAC_USER=TODO_IMAC_USERNAME          # например oleg
# SSH ключ без пароля (или ключ по умолчанию ~/.ssh/id_ed25519)
IMAC_SSH_KEY=~/.ssh/id_ed25519
# Путь на iMac, где будут клонироваться и собираться проекты
IMAC_WORK_DIR=/Users/TODO_IMAC_USERNAME/personal_worker

# --- Flutter (локально) ---
FLUTTER_SDK_PATH=TODO_FLUTTER_SDK     # оставьте пустым, если SDK только в Docker
