# ============================================================
# personal_worker — переменные окружения
# ============================================================
#
# ВАЖНО: на проде (.env на деплой-машине) этот файл ГЕНЕРИРУЕТСЯ ДЕПЛОЕМ
# из GitHub Secrets (deploy/render_secrets.py, шаг «Render secrets» в
# deploy.yml). Руками его не редактируйте — перезапишется.
#
# Секреты хранятся в GitHub (Settings → Secrets and variables → Actions):
#   TELEGRAM_BOT_TOKEN     — токен Telegram-бота
#   OPENHANDS_API_KEY      — ключ API сервера OpenHands
#   OPENHANDS_LLM_API_KEY  — ключ провайдера LLM (provod.ai)
#   GH_APP_PRIVATE_KEY     — приватный ключ GitHub App (PEM целиком)
#
# Залить секреты с машины, где есть старый .env:
#   python3 deploy/sync_secrets.py
#
# Все НЕ-секретные настройки живут в orchestrator/config.yaml (в git) —
# переменные ниже нужны только для локальной разработки без config.yaml.
#
# Итоговый .env на проде выглядит так (создаётся деплоем):
# ------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=<из GitHub Secrets>
# OPENHANDS_API_KEY=<из GitHub Secrets>
# OPENHANDS_LLM_API_KEY=<из GitHub Secrets>
# GITHUB_APP_PRIVATE_KEY_PATH=/mnt/ssd/personal_worker/config/github-app.private-key.pem
# ------------------------------------------------------------

# --- Не-секретные переопределения (необязательно; по умолчанию — config.yaml) ---
# Каталог рабочих копий задач
WORK_DIR=/mnt/ssd/personal_worker/workspaces
# SQLite с задачами
STATE_DB=/mnt/ssd/personal_worker/state/orchestrator.sqlite
# Репозиторий с задачами (owner/name) и метка триггер
GITHUB_REPO=PrigodaOleg/social_mind
GITHUB_LABEL=aitask
# GitHub App (идентификаторы не секретны; PEM — в GitHub Secrets)
GITHUB_APP_ID=TODO_APP_ID
GITHUB_APP_INSTALLATION_ID=TODO_INSTALLATION_ID
GITHUB_APP_PRIVATE_KEY_PATH=/mnt/ssd/personal_worker/config/github-app.private-key.pem
# OpenHands и LLM
OPENHANDS_BASE_URL=http://localhost:3000
OPENHANDS_LLM_BASE_URL=https://api.provod.ai/v1
OPENHANDS_LLM_MODEL=openai/
# Telegram
TELEGRAM_ADMIN_USERNAME=TODO_USERNAME
TELEGRAM_ALLOWED_USERNAMES=
# iMac (сборка iOS)
IMAC_HOST=TODO_IMAC_IP
IMAC_USER=pwworker
IMAC_SSH_KEY=~/.ssh/id_ed25519_pwworker
IMAC_WORK_DIR=/Users/pwworker/personal_worker
# Таймаут ожидания уточнения у пользователя и частота опроса, сек
CLARIFICATION_TIMEOUT_SECONDS=172800
CLARIFICATION_POLL_SECONDS=30
